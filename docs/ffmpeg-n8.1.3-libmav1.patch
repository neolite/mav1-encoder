  +
  +#include <mav1.h>
  +
  +#include "libavutil/mem.h"
  +#include "libavutil/opt.h"
  +#include "libavutil/pixdesc.h"
  +#include "avcodec.h"
  +#include "codec_internal.h"
  +#include "encode.h"
  +
  +typedef struct LibMav1Context {
  +    const AVClass *class;
  +    Mav1Encoder *enc;
  +    int metal;
  +    int qindex;
  +    int loop_filter;
  +    int cdef;
  +    int tx_search;
  +    int me_range;
  +} LibMav1Context;
  +
  +static av_cold int libmav1_init(AVCodecContext *avctx)
  +{
  +    LibMav1Context *ctx = avctx->priv_data;
  +    Mav1Config cfg;
  +    char err[256];
  +
  +    mav1_default_config(&cfg, avctx->width, avctx->height);
  +    cfg.use_metal   = ctx->metal;
  +    cfg.qindex      = ctx->qindex;
  +    cfg.loop_filter = ctx->loop_filter;
  +    cfg.cdef        = ctx->cdef;
  +    cfg.tx_search   = ctx->tx_search;
  +    cfg.me_range    = ctx->me_range;
  +    cfg.keyint      = avctx->gop_size > 0 ? avctx->gop_size : 0;
  +
  +    ctx->enc = mav1_create(&cfg, err, sizeof(err));
  +    if (!ctx->enc) {
  +        av_log(avctx, AV_LOG_ERROR, "mav1_create failed: %s\n", err);
  +        return AVERROR_EXTERNAL;
  +    }
  +    av_log(avctx, AV_LOG_VERBOSE, "mav1 backend: %s\n", mav1_backend_name(ctx->enc));
  +
  +    if (avctx->flags & AV_CODEC_FLAG_GLOBAL_HEADER) {
  +        uint8_t hdr[64];
  +        size_t n = mav1_sequence_header(ctx->enc, hdr);
  +        avctx->extradata = av_mallocz(n + AV_INPUT_BUFFER_PADDING_SIZE);
  +        if (!avctx->extradata)
  +            return AVERROR(ENOMEM);
  +        memcpy(avctx->extradata, hdr, n);
  +        avctx->extradata_size = n;
  +    }
  +    return 0;
  +}
  +
  +static int libmav1_encode(AVCodecContext *avctx, AVPacket *pkt,
  +                          const AVFrame *frame, int *got_packet)
  +{
  +    LibMav1Context *ctx = avctx->priv_data;
  +    const uint8_t *planes[3] = { frame->data[0], frame->data[1], frame->data[2] };
  +    int strides[3] = { frame->linesize[0], frame->linesize[1], frame->linesize[2] };
  +    uint8_t *out;
  +    size_t size;
  +    int ret;
  +
  +    if (mav1_encode(ctx->enc, planes, strides, &out, &size))
  +        return AVERROR_EXTERNAL;
  +    ret = ff_get_encode_buffer(avctx, pkt, size, 0);
  +    if (ret < 0) {
  +        free(out);
  +        return ret;
  +    }
  +    memcpy(pkt->data, out, size);
  +    free(out);
  +    if (mav1_last_stats(ctx->enc)->frame_type == 0)
  +        pkt->flags |= AV_PKT_FLAG_KEY;
  +    pkt->pts = pkt->dts = frame->pts;
  +    *got_packet = 1;
  +    return 0;
  +}
  +
  +static av_cold int libmav1_close(AVCodecContext *avctx)
  +{
  +    LibMav1Context *ctx = avctx->priv_data;
  +    mav1_destroy(ctx->enc);
  +    ctx->enc = NULL;
  +    return 0;
  +}
